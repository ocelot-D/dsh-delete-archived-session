{
  "name": "dsh-delete-archived-session",
  "version": "0.1.0",
  "description": "List and delete archived DeepSeek Harness sessions: move a session's log to a trash folder (reversible) or purge it, behind explicit confirmation and per-log ownership proof.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "session",
    "archive",
    "delete"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/dsh-delete-archived-session.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0",
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/self-test.js && node test/check-manifest.js"
  }
}
